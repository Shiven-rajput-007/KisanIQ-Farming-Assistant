# ==============================================================================
# KisanIQ Production Environment Variables Configuration Template
# ==============================================================================

# --- Backend Configuration (Render / Server) ---
NODE_ENV=production
PORT=8000

# PostgreSQL Database (Neon PostgreSQL connection string with SSL)
DATABASE_URL=postgres://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/kisaniq?sslmode=require

# Authentication & Security
JWT_SECRET_KEY=your_super_secret_64_character_hex_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins (comma-separated list for Netlify frontend & local dev)
CORS_ORIGINS=https://kisaniq-farm.netlify.app,http://localhost:5173

# Government of India Agmarknet / OGD API Key (data.gov.in)
# Obtain your free key from https://data.gov.in
DATA_GOV_IN_API_KEY=your_40_char_data_gov_in_api_key_here

# Secret token to protect the POST /api/market/sync endpoint from unauthorized triggers
MANDI_SYNC_SECRET=your_random_32_char_sync_secret_token_here

# External Weather Service Base URL
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# --- Frontend Configuration (Netlify / Client) ---
# Note: In Netlify, configure VITE_API_URL pointing to your Render backend API
VITE_API_URL=https://your-backend.onrender.com/api
